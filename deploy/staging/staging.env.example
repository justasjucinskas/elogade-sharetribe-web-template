# ~/web-template-staging/staging.env on the VM (chmod 600). Runtime values for the staging
# container; REACT_APP_* used by the browser are baked into the image by build-and-deploy.sh.
# Staging = Sharetribe Test environment `checkme-test`.
NODE_ENV=production
PORT=3000
REACT_APP_ENV=production
REACT_APP_SHARETRIBE_SDK_CLIENT_ID=<checkme-test client id>
SHARETRIBE_SDK_CLIENT_SECRET=<checkme-test client secret>
REACT_APP_MARKETPLACE_ROOT_URL=https://staging.elogade.com
REACT_APP_MARKETPLACE_NAME=Elogade
REACT_APP_SHARETRIBE_USING_SSL=true
SERVER_SHARETRIBE_TRUST_PROXY=true
SERVER_SHARETRIBE_REDIRECT_SSL=true
REACT_APP_CSP=report
REACT_APP_PRICE_OFFERS_ENABLED=true
